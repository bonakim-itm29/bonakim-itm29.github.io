 "ticker": "TCOM",
 "top": [
  {
   "date": "2026-01-14",
   "filed": "2026-01-15",
   "title_ko": "중국 SAMR 반독점 조사 착수 통보",
   "summary_ko": "Trip.com은 중국 국가시장감독관리총국(SAMR)으로부터 반독점법 위반 혐의 조사 통지를 받았다고 발표했다(보도자료 일자 1월 14일, 6-K 제출 1월 15일). 당일 주가는 -17.1% 하락했고 매크로 예측은 -0.5%에 불과해 잔차는 -18.2%였다.",
   "why_important_ko": "규제 리스크가 현실화된 회사 고유 사건으로, 이후 1Q26 실적 공시에서도 조사 진행과 '컴플라이언스 조정'이 성장 둔화 요인으로 언급됨.",
   "facts": [
    {
     "fact_ko": "SAMR로부터 조사 통지를 받음",
     "quote": "it has received a notice of investigation from the State Administration for Market Regulations",
     "file": "raw_events/TCOM__000119312526013470__d83533dex991.htm"
    },
    {
     "fact_ko": "근거 법률은 중국 반독점법",
     "quote": "pursuant to the Anti-Monopoly Law of the People’s Republic of China",
     "file": "raw_events/TCOM__000119312526013470__d83533dex991.htm"
    },
    {
     "fact_ko": "회사는 영업이 정상이라고 밝힘",
     "quote": "Its business operations remain normal.",
     "file": "raw_events/TCOM__000119312526013470__d83533dex991.htm"
    },
    {
     "fact_ko": "1Q26 공시: 시장지배적 지위 남용 여부 조사, 협조 중",
     "quote": "whether the Company has abused or is abusing a dominant market position",
     "file": "raw/TCOM__6-K__2026-06-25__d163607dex991.htm"
    }
   ]
  },
  {
   "date": "2015-10-26",
   "filed": "2015-10-26",
   "title_ko": "바이두와 주식교환으로 Qunar 지분 확보",
   "summary_ko": "Ctrip은 바이두가 보유한 Qunar 주식을 신주 11,488,381주와 교환하는 거래를 완료해 Qunar 의결권 약 45%를 확보하고 바이두는 Ctrip 의결권 약 25%를 보유하게 됐다고 발표했다. 당일 주가는 +22.1% 상승, 매크로 예측 -0.1%, 잔차 +20.0%였다.",
   "why_important_ko": "최대 경쟁사 Qunar를 사실상 편입하고 바이두를 대주주로 맞은 업계 구조 재편·지분 구조 변경 사건(같은 해 5월 eLong 지분 인수에 이은 통합).",
   "facts": [
    {
     "fact_ko": "바이두의 Qunar 주식과 Ctrip 신주를 교환",
     "quote": "in exchange for 11,488,381 newly-issued ordinary shares of Ctrip",
     "file": "raw_events/TCOM__000110465915072624__a15-21702_1ex99d1.htm"
    },
    {
     "fact_ko": "교환비율 Qunar ADS당 Ctrip ADS 0.725",
     "quote": "The share exchange ratio for the transaction is 0.725 Ctrip ADSs per Qunar ADS.",
     "file": "raw_events/TCOM__000110465915072624__a15-21702_1ex99d1.htm"
    },
    {
     "fact_ko": "바이두는 Ctrip 의결권 약 25% 보유",
     "quote": "Baidu will own ordinary shares of Ctrip representing approximately 25%",
     "file": "raw_events/TCOM__000110465915072624__a15-21702_1ex99d1.htm"
    },
    {
     "fact_ko": "Ctrip은 Qunar 의결권 약 45% 보유",
     "quote": "Ctrip will own ordinary shares of Qunar representing approximately 45%",
     "file": "raw_events/TCOM__000110465915072624__a15-21702_1ex99d1.htm"
    }
   ]
  }
 ],
